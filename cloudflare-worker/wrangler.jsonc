{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sticker-wall-ai",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "ratelimits": [
    {
      "name": "AI_BURST_LIMITER",
      "namespace_id": "26091101",
      "simple": {
        "limit": 1,
        "period": 10
      }
    },
    {
      "name": "AI_ROOM_LIMITER",
      "namespace_id": "26091102",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}

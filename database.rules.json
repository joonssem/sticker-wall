{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2'",
        "phase": { ".write": "auth != null && auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2'" },
        "selectedPostId": { ".write": "auth != null && auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2'" },
        "showAttendance": { ".write": "auth != null && auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2'" },
        "colorLocks": {
          "$color": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2')"
          }
        },
        "posts": {
          "$post": {
            ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && data.child('authorId').val() === auth.uid && (!newData.exists() || (newData.child('authorId').val() === auth.uid && newData.child('authorColorId').val() === data.child('authorColorId').val()))) || auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2')",
            ".validate": "newData.hasChildren(['authorId','authorColorId','text','createdAt'])",
            "questions": {
              "$question": {
                ".write": "auth != null && !data.exists() && newData.child('authorId').val() === auth.uid",
                ".validate": "newData.hasChildren(['text','authorId','createdAt'])",
                "answers": {
                  "$answer": {
                    ".write": "auth != null && !data.exists() && newData.child('authorId').val() === auth.uid && newData.parent().numChildren() < 2 && newData.parent().parent().child('authorId').val() !== auth.uid",
                    ".validate": "newData.hasChildren(['text','authorId','createdAt'])"
                  }
                }
              }
            }
          }
        }
      }
    },
    "teacherRecords": {
      "$room": {
        "participants": {
          ".read": "auth != null && auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2'",
          "$uid": {
            ".read": "auth != null && auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2'",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2')"
          }
        }
      }
    },
    "teacherBoards": {
      "$uid": {
        ".read": "auth != null && auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2' && auth.uid === $uid",
        "$room": {
          ".write": "auth != null && auth.uid === 'Z6WEsEFSTBbq6eeIF3E0RaBGoQZ2' && auth.uid === $uid"
        }
      }
    }
  }
}
